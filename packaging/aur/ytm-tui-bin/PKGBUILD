# Maintainer: Maksim23Gamer <https://github.com/Maksim23Gamer>
# Готовый бинарь из GitHub Releases (быстрая установка, без компиляции).
pkgname=ytm-tui-bin
pkgver=0.2.0
pkgrel=1
pkgdesc='TUI-плеер YouTube Music (ytm) и YouTube (ytt) с настоящими обложками — готовый бинарь'
arch=('x86_64')
url='https://github.com/maks456230/YoutubeTui'
license=('MIT')
depends=('gcc-libs' 'mpv' 'yt-dlp' 'curl')
provides=('ytm' 'ytt' 'ytm-tui')
conflicts=('ytm-tui' 'ytm-tui-git')
source_x86_64=("$url/releases/download/v$pkgver/ytm-tui-v$pkgver-x86_64-unknown-linux-gnu.tar.gz")
sha256sums_x86_64=('SKIP')

package() {
  install -Dm755 ytm "$pkgdir/usr/bin/ytm"
  install -Dm755 ytt "$pkgdir/usr/bin/ytt"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
